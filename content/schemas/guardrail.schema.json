{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://superagentskill.com/schemas/guardrail.schema.json",
  "title": "Guardrail",
  "type": "object",
  "required": ["slug", "name", "type", "version", "description", "rules", "license", "authors"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]{2,64}$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "type": { "const": "guardrail" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "minLength": 20, "maxLength": 280 },
    "applies_to": {
      "type": "array",
      "items": { "enum": ["skill", "playbook", "soul", "any"] }
    },
    "severity": { "enum": ["info", "warn", "block"] },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "match": { "type": "string", "description": "Regex or natural-language matcher" },
          "action": { "enum": ["block", "warn", "rewrite", "ask_user"] }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "license": { "type": "string" },
    "authors": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
