{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://superagentskill.com/schemas/playbook.schema.json",
  "title": "Playbook",
  "type": "object",
  "required": ["slug", "name", "type", "version", "description", "steps", "license", "authors"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]{2,64}$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "type": { "const": "playbook" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "minLength": 20, "maxLength": 280 },
    "long_description": { "type": "string" },
    "trigger": { "type": "string", "description": "When this playbook should be invoked" },
    "inputs": { "type": "object" },
    "outputs": { "type": "object" },
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "action"],
        "properties": {
          "id": { "type": "string" },
          "action": { "type": "string", "description": "skill:<slug>, tool:<name>, or instruction" },
          "with": { "type": "object" },
          "when": { "type": "string" },
          "on_error": { "enum": ["abort", "continue", "retry"] }
        }
      }
    },
    "guardrails": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "license": { "type": "string" },
    "authors": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
