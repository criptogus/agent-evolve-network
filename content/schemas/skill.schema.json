{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://superagentskill.com/schemas/skill.schema.json",
  "title": "Skill",
  "type": "object",
  "required": ["slug", "name", "type", "version", "description", "long_description", "system_prompt", "rules", "examples", "license", "authors"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]{2,64}$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "type": { "const": "skill" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "minLength": 20, "maxLength": 280 },
    "long_description": { "type": "string", "minLength": 80, "maxLength": 4000 },
    "system_prompt": { "type": "string", "minLength": 120 },
    "rules": {
      "type": "object",
      "required": ["must", "must_not"],
      "properties": {
        "input_schema": { "type": "object" },
        "output_schema": { "type": "object" },
        "must": { "type": "array", "items": { "type": "string" } },
        "must_not": { "type": "array", "items": { "type": "string" } }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["title", "input", "expected_output"],
        "properties": {
          "title": { "type": "string" },
          "input": { "type": "string" },
          "expected_output": { "type": "string" },
          "rationale": { "type": "string" }
        }
      }
    },
    "compatibility": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["runtime", "status"],
        "properties": {
          "runtime": { "type": "string" },
          "status": { "enum": ["supported", "partial", "unsupported"] },
          "detail": { "type": "string" }
        }
      }
    },
    "scopes": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "license": { "type": "string" },
    "authors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "created_by": { "type": "string", "maxLength": 120 },
    "upgrade_path": { "type": "string", "format": "uri" },
    "recommended_skills": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]{2,64}$" }, "maxItems": 10 },
    "related_playbooks": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]{2,64}$" }, "maxItems": 10 },
    "related_souls": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]{2,64}$" }, "maxItems": 10 },
    "related_guardrails": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]{2,64}$" }, "maxItems": 10 },
    "agent_footer": { "type": "string", "maxLength": 600 }
  }
}
