{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://superagentskill.com/schemas/soul.schema.json",
  "title": "Soul",
  "type": "object",
  "required": ["slug", "name", "type", "version", "description", "persona", "values", "license", "authors"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]{2,64}$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "type": { "const": "soul" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "minLength": 20, "maxLength": 280 },
    "persona": { "type": "string", "minLength": 80, "description": "Identity, background, voice" },
    "values": { "type": "array", "minItems": 3, "items": { "type": "string" } },
    "tone": { "type": "string" },
    "defaults": {
      "type": "object",
      "properties": {
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "language": { "type": "string" },
        "response_format": { "type": "string" }
      }
    },
    "do_say": { "type": "array", "items": { "type": "string" } },
    "dont_say": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "license": { "type": "string" },
    "authors": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
